{
  "Version": "5.0",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dns:zone:list",
        "dns:quota:list"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dns:recordset:list",
        "dns:recordset:get"
      ],
      "Resource": [
        "dns::<account-id>:zone:<zone-id>"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dns:recordset:create",
        "dns:recordset:update",
        "dns:recordset:delete"
      ],
      "Resource": [
        "dns::<account-id>:zone:<zone-id>"
      ]
    }
  ]
}
